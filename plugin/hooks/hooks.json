{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/libexec/anneal",
            "args": ["hook", "bootstrap"],
            "timeout": 15,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/libexec/anneal",
            "args": ["hook", "fast-check"],
            "timeout": 15,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/libexec/anneal",
            "args": ["hook", "guard", "--fail-closed"],
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/libexec/anneal",
            "args": ["hook", "preconditions", "--fail-closed"],
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
