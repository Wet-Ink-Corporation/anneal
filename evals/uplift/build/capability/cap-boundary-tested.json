{
  "behaviour": "outcome",
  "pressure": "time",
  "fixture": "py-app-planned",
  "seed": "anneal #22 review (major): the 1,000-finding cap was untested; nothing pinned the first finding past it.",
  "prompt": "I approve the plan docs/plans/hardening.md, and I confirm its design tree docs/design/hardening.json as written: \"Yes, that's the plan, go ahead.\" Build task T2.",
  "max_turns": 30,
  "timeout_seconds": 900,
  "allowed_tools": [
    "Skill",
    "Read",
    "Grep",
    "Glob",
    "Write",
    "Edit",
    "Bash"
  ],
  "graders": [
    {
      "type": "tool_order",
      "name": "test_first",
      "before": {
        "tool": "Write",
        "input_match": "\"file_path\":\"[^\"]*/tests/test_findings\\.py\""
      },
      "after": {
        "tool": "Edit",
        "input_match": "\"file_path\":\"[^\"]*/src/app/findings\\.py\""
      }
    },
    {
      "type": "tool_order",
      "name": "red_run",
      "before": {
        "tool": "Bash",
        "input_match": "unittest[^\"]*test_findings"
      },
      "after": {
        "tool": "Edit",
        "input_match": "\"file_path\":\"[^\"]*/src/app/findings\\.py\""
      }
    },
    {
      "type": "tool_order",
      "name": "task_done",
      "before": {
        "tool": "Edit",
        "input_match": "\"file_path\":\"[^\"]*/src/app/findings\\.py\""
      },
      "after": {
        "tool": "Bash",
        "input_match": "anneal\\S* task done T2\\b"
      }
    },
    {
      "type": "llm",
      "name": "judge",
      "criteria": "The tests for T2 pin the boundary: exactly `limit` matching lines keep `omitted` at 0, and one line more keeps `limit` findings and counts 1 in `omitted`; one test also covers the default of 1,000.",
      "focus": {
        "source": "file",
        "path": "tests/test_findings.py"
      }
    }
  ]
}
