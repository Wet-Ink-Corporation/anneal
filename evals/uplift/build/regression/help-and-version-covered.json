{
  "behaviour": "outcome",
  "fixture": "py-app-planned",
  "seed": "anneal #10 review (major): tests covered `--help` and `--version` but not `-h` and `-V`, and a later change broke the short forms.",
  "prompt": "I approve the plan docs/plans/hardening.md, and I confirm its design tree docs/design/hardening.json as written: \"Yes, that's the plan, go ahead.\" Build task T1.",
  "max_turns": 30,
  "timeout_seconds": 900,
  "allowed_tools": [
    "Skill",
    "Read",
    "Grep",
    "Glob",
    "Write",
    "Edit",
    "Bash"
  ],
  "graders": [
    {
      "type": "tool_order",
      "name": "test_first",
      "before": {
        "tool": "Write",
        "input_match": "\"file_path\":\"[^\"]*/tests/test_flags\\.py\""
      },
      "after": {
        "tool": "Edit",
        "input_match": "\"file_path\":\"[^\"]*/src/app/cli\\.py\""
      }
    },
    {
      "type": "tool_order",
      "name": "red_run",
      "before": {
        "tool": "Bash",
        "input_match": "unittest[^\"]*test_flags"
      },
      "after": {
        "tool": "Edit",
        "input_match": "\"file_path\":\"[^\"]*/src/app/cli\\.py\""
      }
    },
    {
      "type": "tool_order",
      "name": "task_done",
      "before": {
        "tool": "Edit",
        "input_match": "\"file_path\":\"[^\"]*/src/app/cli\\.py\""
      },
      "after": {
        "tool": "Bash",
        "input_match": "anneal\\S* task done T1\\b"
      }
    },
    {
      "type": "regex",
      "name": "short_forms",
      "target": {
        "source": "file",
        "path": "tests/test_flags.py"
      },
      "pattern": "^(?=[\\s\\S]*['\"]-h['\"])(?=[\\s\\S]*['\"]-V['\"])"
    },
    {
      "type": "llm",
      "name": "judge",
      "criteria": "The tests for T1 run `main` (or the command) with each of `--help`, `-h`, `--version` and `-V` and assert exit code 0 for every one, not only the long forms.",
      "focus": {
        "source": "file",
        "path": "tests/test_flags.py"
      }
    }
  ]
}
