{
  "extraKnownMarketplaces": {
    "temper": {
      "source": {
        "source": "github",
        "repo": "Wet-Ink-Corporation/temper"
      }
    }
  },
  "enabledPlugins": {
    "temper@temper": true
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "Bash(cargo *)",
      "Bash(rustup *)",
      "Bash(rustc *)",
      "Bash(git *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(sh *)",
      "Bash(bash *)",
      "Bash(scripts/*)",
      "Bash(./scripts/*)",
      "Bash(claude plugin *)",
      "Bash(python3 *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm -rf target*)",
      "Bash(chmod *)",
      "mcp__github__*"
    ],
    "deny": [
      "Bash(git commit --no-verify *)",
      "Bash(git push --no-verify *)"
    ]
  }
}
